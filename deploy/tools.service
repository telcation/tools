# /etc/systemd/system/tools.service
[Unit]
Description=Teaching tools (nisshi / chime) - Flask / gunicorn, port 5012
After=network.target

[Service]
User=appuser
Group=appuser
WorkingDirectory=/home/appuser/apps/tools
ExecStart=/home/appuser/apps/tools/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5012 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
